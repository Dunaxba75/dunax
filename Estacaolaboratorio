<title>DULUB | Etiquetas de Amostra — Laboratório</title>
<style>
  body { font-family:'Segoe UI', Roboto, Arial, sans-serif; background:#f0f2f5; margin:0; color:#333; }
  .header { background:#1e3a5f; color:#fff; padding:12px 20px; display:flex; justify-content:space-between; align-items:center; }
  .header .t { font-weight:bold; font-size:17px; letter-spacing:1px; }
  .header .h { font-size:13px; opacity:.9; }
  .wrap { max-width:1250px; margin:0 auto; padding:14px; }
  .topo { display:flex; gap:10px; flex-wrap:wrap; align-items:stretch; margin-bottom:12px; }
  .card { background:#fff; border-radius:10px; padding:10px 14px; box-shadow:0 2px 4px rgba(0,0,0,.08); border-left:6px solid #95a5a6; min-width:230px; }
  .card.ok { border-left-color:#27ae60; } .card.erro { border-left-color:#c0392b; } .card.aviso { border-left-color:#e67e22; }
  .card .r { font-size:11px; font-weight:bold; color:#7f8c8d; text-transform:uppercase; }
  .card .v { font-size:15px; font-weight:bold; margin-top:4px; }
  .card .s { font-size:11.5px; color:#7f8c8d; margin-top:2px; }
  button { font-family:inherit; }
  .bt { padding:9px 14px; border:none; border-radius:8px; font-weight:bold; font-size:13px; cursor:pointer; color:#fff; background:#2980b9; }
  .bt.verde { background:#27ae60; } .bt.cinza { background:#7f8c8d; } .bt.laranja { background:#e67e22; } .bt.vermelho { background:#c0392b; }
  .bt:disabled { background:#bdc3c7; cursor:not-allowed; }
  .grade { display:grid; grid-template-columns:360px 1fr; gap:14px; }
  .lista { background:#fff; border-radius:10px; box-shadow:0 2px 4px rgba(0,0,0,.08); overflow:hidden; align-self:start; }
  .lista .tit { background:#ecf0f1; padding:10px 14px; font-weight:bold; font-size:13px; color:#2c3e50; display:flex; justify-content:space-between; align-items:center; }
  .item { padding:10px 14px; border-top:1px solid #eef0f2; cursor:pointer; }
  .item:hover { background:#f7f9fb; }
  .item.sel { background:#eaf3fb; border-left:5px solid #2980b9; padding-left:9px; }
  .item .l1 { font-weight:bold; font-size:14px; color:#2c3e50; }
  .item .l2 { font-size:12px; color:#7f8c8d; margin-top:2px; }
  .tag { display:inline-block; font-size:10.5px; font-weight:bold; padding:2px 7px; border-radius:10px; background:#eee; color:#555; margin-right:4px; }
  .tag.pre { background:#e8f6ee; color:#1e8449; } .tag.base { background:#fdf2e3; color:#a35b00; } .tag.man { background:#eef0f7; color:#34495e; }
  .tag.feita { background:#27ae60; color:#fff; }
  .vazio { padding:20px 14px; color:#95a5a6; font-size:13px; text-align:center; }
