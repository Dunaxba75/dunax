          <div><label>Turno</label><select id="fTurno"><option value=""></option><option>1</option><option>2</option><option>3</option></select></div>
          <div><label>Data de coleta</label><input id="fData" placeholder="dd/mm/aa" oninput="dataMudou()"></div>
