<body>

<div class="header">
  <div class="t">DULUB | ETIQUETAS DE AMOSTRA — LABORATÓRIO <span style="font-size:11px;opacity:.6;font-weight:normal;">versão 23/10</span></div>
  <div class="h" id="relogio">--:--:--</div>
</div>

<div class="wrap">
  <div class="topo">
    <div class="card" id="cardZebra"><div class="r">Zebra (Browser Print)</div><div class="v" id="txtZebra">Procurando...</div><div class="s" id="subZebra"></div></div>
    <div class="card" id="cardFila"><div class="r">Fila de etiquetas</div><div class="v" id="txtFila">Carregando...</div><div class="s" id="subFila"></div></div>
    <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
      <button class="bt verde" onclick="novaEtiqueta()">➕ NOVA ETIQUETA</button>
