  .campos .dois { grid-column:span 2; } .campos .quatro { grid-column:span 4; }
  .campos label { display:block; font-size:11.5px; font-weight:bold; color:#555; margin-bottom:3px; }
  .campos input, .campos select { width:100%; box-sizing:border-box; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:14px; }
