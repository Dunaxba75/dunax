            <select id="fSituacao" onchange="situacaoMudou()"><option value="APROVADO">( X ) APROVADO</option><option value="CONDIC">( X ) APROVADO CONDICIONAL</option><option value="REPROVADO">( X ) REPROVADO</option></select></div>
