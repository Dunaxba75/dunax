  .config { background:#fff; border-radius:10px; box-shadow:0 2px 4px rgba(0,0,0,.08); padding:14px; margin-bottom:12px; display:none; border-left:6px solid #2980b9; }
  .config h3 { margin:0 0 10px; font-size:15px; }
  .config .linha { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }
